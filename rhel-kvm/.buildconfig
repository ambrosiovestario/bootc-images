# .buildconfig file for restricting builds to specific architectures

# Valid values: linux/amd64, linux/arm64
platforms: linux/amd64

##### INSTALLABLE ARTIFACTS
# Valid values: true, false, auto
# Note auto creates an instalable artifact if it does not exist any
#artifacts: auto

# Valid values: bootc-generic-iso, bootc-installer, qcow2, vmdk, raw, ami, vhd, gce
artifact_formats: bootc-generic-iso


# bootc-generic-iso (and bootc-installer) are currently x86_64-only in
# image-builder: they unconditionally require legacy-BIOS grub2 files under
# /usr/lib/grub/i386-pc, which cannot exist on arm64 (no BIOS boot mode).
# Restrict the ISO artifact to amd64 while still building the bootc
# container image itself for both platforms above. Remove this once
# image-builder supports arm64 ISOs.
artifact_platforms: linux/amd64


##### INSTALLER (required for bootc-generic-iso and bootc-installer formats)
# Name of the image built under _base_anaconda_images_/<name>/ (Anaconda +
# tooling, no kickstart). The workflow pulls that base, then builds
# ./installer/Containerfile in THIS directory on top of it (FROM
# ${BASE_IMAGE} build-arg), producing a local, not-published image used as
# --bootc-ref. This app's own image is passed as
# --bootc-installer-payload-ref. Edit ./installer/kickstart.ks and
# ./installer/iso.yaml to customize this app's install, not the workflow.
installer_base: anaconda-rhel10-base

##### VERSION MANAGEMENT
# Valid values: true, false
# When true, keeps the existing version instead of incrementing (default: false)
keep_version: true